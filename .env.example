# ---------------------------------------------------------------------------
# Kynd — environment template
# Copy to .env and fill in. Never commit .env itself.
# See README.md "Environment variables" for the full reference.
# ---------------------------------------------------------------------------

# --- LLM access (required) -------------------------------------------------
OPENROUTER_API_KEY=
# Optional fallback, used only when OPENROUTER_API_KEY is unset.
# OPENAI_API_KEY=

# Optional gateway/model overrides.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_CHAT_MODEL=deepseek/deepseek-v4-flash

# Local model provider (provider = "ollama"), used instead of OpenRouter.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama

# --- Execution mode --------------------------------------------------------
# Unset -> server actions delegate to VPS_BACKEND_URL.
# true  -> use cases run in-process (needs the browser server below).
# FORCE_LOCAL=true

# Required only when the browser runs in-process.
# Start the server with: node playwright-server.js
# PLAYWRIGHT_WS_ENDPOINT=ws://localhost:8081/playwright-ws

# --- Remote backend (VPS) --------------------------------------------------
# VPS_BACKEND_URL=http://localhost:8080
# VPS_AUTH_TOKEN=
# Set to true on the VPS host; any other value 404s /api/vps/*.
# IS_VPS=true

# --- Pipeline tuning (optional) -------------------------------------------
# LOG_DIR=/path/to/logs           # default: current working directory
# PERSONA_TOKEN_LIMIT=2000
# AUDIT_RATE_LIMIT_MAX=5
# AUDIT_RATE_LIMIT_WINDOW_MS=60000

# --- Local Playwright server (optional) -----------------------------------
# PLAYWRIGHT_PORT=8081
# PLAYWRIGHT_WS_PATH=playwright-ws
